# Copy to .env.local for local development. Never commit the real file —
# .gitignore already excludes .env, .env.local, and .env.*.local.
#
# In production, set these in Vercel: Project Settings -> Environment Variables.
# Never paste real secret values into chat, source control, or this file.

# ---- Upstash Redis ----------------------------------------------------
# Whichever pair your Vercel project's Upstash integration actually
# provisioned. Check Project Settings -> Environment Variables in Vercel
# to confirm which one is present in your project, then only fill in that
# pair. The code checks both, in this order.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# --- OR, if Upstash was connected directly (not via the Vercel Marketplace
# integration), it will use this pair instead: ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Resend (owner notification email) --------------------------------
RESEND_API_KEY=
# Where signup notifications are sent.
OWNER_EMAIL=
# Sender address. Until a custom domain is verified in Resend, use
# onboarding@resend.dev (Resend's own shared sender — no DNS setup
# required). Once a domain is verified, switch this to an address on
# that domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---- Stats endpoint protection -----------------------------------------
# Any long random string you generate yourself, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
STATS_TOKEN=
